void setup() {
  Serial.begin(115200);

  //  digitalWrite(RESET_PIN, HIGH);
  //  pinMode(RESET_PIN, OUTPUT);

  digitalWrite(enPin, HIGH);
  pinMode(enPin, OUTPUT);

  pinMode(limit_sorter, INPUT_PULLUP);
  stepper.setMaxSpeed(800);
  stepper.setAcceleration(400);

  pinMode(CLK_PIN, INPUT_PULLUP);
  pinMode(DT_PIN, INPUT_PULLUP);
  pinMode(SW_PIN, INPUT_PULLUP);
  pinMode(STOP_BTN_PIN, INPUT_PULLUP);

  digitalWrite(buzzerPin, LOW); // ปิด Buzzer ก่อนเสมอ
  pinMode(buzzerPin, OUTPUT);

  pinMode(limit_servo, INPUT);
  pinMode(st188Pin, INPUT_PULLUP);
  pinMode(intEmer, INPUT_PULLUP);

  loadAllFromEEPROM();

  myServo.write(servo_stop); // ⚠️ สั่งตำแหน่งเริ่มต้นก่อน attach (กันเซอร์โวดีด)
  myServo.attach(servoPin);

  // Linear Actuator
  servoPWM = 998;
  actuator.writeMicroseconds(servoPWM);
  actuator.attach(rcPin);

  u8g2.begin();
  updateDisplay();
  lastStateCLK = digitalRead(CLK_PIN); // อ่านค่าเริ่มต้นหลังไฟนิ่งแล้ว

  //  attachInterrupt(digitalPinToInterrupt(intEmer), runEmergencyHalt, FALLING);

  for_beep_fast();
  runHoming();
  for_beep_fast();

  Serial.println("======================= MCU Started =======================");
}
void loop() {
  // ==================================================
  // [ส่วนที่ 1] ตรวจจับความเคลื่อนไหว เพื่อรีเซ็ตเวลาพักจอ
  // ==================================================
  bool userActivity = false;

  // 1.1 เช็คการหมุน Rotary
  static int globalLastClk = HIGH;
  int currentClk = digitalRead(CLK_PIN);
  if (currentClk != globalLastClk) {
    userActivity = true;
    globalLastClk = currentClk;
  }

  // 1.2 เช็คการกดปุ่ม (Rotary หรือ Stop) และเช็คว่ามี Serial สั่งงานเข้ามารึเปล่า
  if (digitalRead(SW_PIN) == LOW || digitalRead(STOP_BTN_PIN) == LOW || Serial.available() > 0) {
    userActivity = true;
  }

  // ถ้าระบบพบการใช้งาน จะรีเซ็ตตัวจับเวลา
  if (userActivity) {
    lastActivityTime = millis();

    // ถ้าหน้าจอพักอยู่ ให้ตื่นขึ้นมา
    if (isScreensaverActive) {
      isScreensaverActive = false;
      lastCursorIndex = -1; // บังคับให้จอวาดเมนูเดิมอีกครั้ง

      // ดักรอจนกว่าคนจะปล่อยปุ่ม (ป้องกันปุ่มลั่นตอนปลุกจอ)
      while (digitalRead(SW_PIN) == LOW || digitalRead(STOP_BTN_PIN) == LOW);
      delay(100);
      return; // สั่งออกลูปเพื่อข้ามการเช็คปุ่มในรอบนี้ไปก่อน
    }
  }

  if (currentMenu == 0 && (millis() - lastActivityTime > SCREENSAVER_TIMEOUT)) {

    // ถ้าเพิ่งเริ่มพักจอ ให้วาดรูปแค่ "ครั้งเดียว" (ไม่ต้องวาดซ้ำๆ ให้เปลือง CPU)
    if (!isScreensaverActive) {
      isScreensaverActive = true;

      // คำนวณจุดเริ่มวาด (X, Y) เพื่อให้รูปอยู่ตรงกลางจอพอดีเสมอ
      int startX = (128 - logo_width) / 2;
      int startY = (64 - logo_height) / 2;

      u8g2.clearBuffer();
      u8g2.drawXBMP(startX, startY, logo_width, logo_height, epd_bitmap_images);
      u8g2.sendBuffer();
    }

    return; // หยุดการทำงานของ loop บรรทัดล่างชั่วคราว รอจนกว่าจะมีการกดปุ่ม
  }

  // ==================================================
  // [ส่วนที่ 3] โค้ด loop เดิม (ทำงานตอนไม่ได้พักหน้าจอ)
  // ==================================================

  // 3.1 ตรวจสอบคำสั่งจาก Serial
  if (Serial.available() > 0) {
    String command = Serial.readStringUntil('\n');
    command.trim();

    if (command == "<START>") {
      Serial.println("Command Received: Starting Machine...");
      runStart();
      lastCursorIndex = -1;
    }
  }

  // 3.2 จัดการ Rotary Encoder (เมนู)
  handleRotaryMenu();

  // 3.3 ตรวจจับการกดปุ่ม SW
  if (digitalRead(SW_PIN) == LOW) {
    delay(50); // กันปุ่มสั่น
    if (digitalRead(SW_PIN) == LOW) {

      unsigned long pressStartTime = millis();
      bool isLongPress = false;

      // วนลูปรอจนกว่าจะปล่อยปุ่ม หรือกดค้างเกิน 3 วินาที (3000 ms)
      while (digitalRead(SW_PIN) == LOW) {
        if (millis() - pressStartTime >= 3000) {
          isLongPress = true;
          break; // ออกจากลูปเมื่อกดค้างสำเร็จ
        }
      }

      if (isLongPress) {
        // ------------------------------------------
        // [ ทำงานเมื่อกดค้าง : รีเซ็ตบอร์ด ]
        // ------------------------------------------
        u8g2.clearBuffer();
        u8g2.setFont(u8g2_font_8x13B_tf);
        u8g2.setCursor(20, 35);
        u8g2.print("REBOOTING...");
        u8g2.sendBuffer();

        Serial.println("System Reboot Triggered by User!");

        // ส่งเสียงเตือนยาวๆ ก่อนดับ
        digitalWrite(buzzerPin, HIGH);
        delay(1000);
        digitalWrite(buzzerPin, LOW);

        // สั่งรีเซ็ตบอร์ดด้วย Watchdog Timer (หน่วง 15ms แล้วตัดไฟ)
        wdt_enable(WDTO_15MS);
        while (1); // ล็อคโปรแกรมไว้ตรงนี้เพื่อรอให้ Watchdog สับสวิตช์รีเซ็ต

      } else {
        // ------------------------------------------
        // [ ทำงานเมื่อกดปกติ : เข้าเมนู ]
        // ------------------------------------------
        executeMenuAction();

        // ดักรอเผื่อเพิ่งกลับมาจากเมนูย่อย
        while (digitalRead(SW_PIN) == LOW);
        delay(50);
      }
    }
  }

  // 3.4 ตรวจจับการกดปุ่ม STOP/BACK
  if (digitalRead(STOP_BTN_PIN) == LOW) {
    delay(50);
    if (digitalRead(STOP_BTN_PIN) == LOW) {
      if (currentMenu > 0) {
        currentMenu = 0;
        cursorIndex = 0;
        scrollOffset = 0;
        updateDisplay();
      }
      while (digitalRead(STOP_BTN_PIN) == LOW);
      delay(50);
    }
  }

  // 3.5 อัปเดตหน้าจอเฉพาะเมื่อตำแหน่งเปลี่ยน
  if (cursorIndex != lastCursorIndex || currentMenu != lastMenu) {
    updateDisplay();
    lastCursorIndex = cursorIndex;
    lastMenu = currentMenu;
  }
}
